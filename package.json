{
  "name": "zmarkdown-monorepo",
  "version": "1.6.1",
  "description": "zmarkdown — Markdown editor maintained by ZWLFI, derived from MoMark and MarkText",
  "license": "AGPL-3.0-only",
  "private": true,
  "homepage": "https://github.com/ZWLFI/zmarkdown",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "postinstall": "tsx scripts/postinstall.ts",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "minify-locales": "tsx scripts/minify-locales.ts",
    "rebuild-native": "pnpm --filter zmarkdown rebuild-native",
    "start": "pnpm --filter zmarkdown start",
    "dev": "pnpm --filter zmarkdown dev",
    "build": "pnpm --filter zmarkdown build",
    "build:unpack": "pnpm --filter zmarkdown build:unpack",
    "build:win": "pnpm --filter zmarkdown build:win",
    "build:win:x64": "pnpm --filter zmarkdown build:win:x64",
    "build:win:arm64": "pnpm --filter zmarkdown build:win:arm64",
    "build:mac": "pnpm --filter zmarkdown build:mac",
    "build:mac:x64": "pnpm --filter zmarkdown build:mac:x64",
    "build:mac:arm64": "pnpm --filter zmarkdown build:mac:arm64",
    "build:linux": "pnpm --filter zmarkdown build:linux",
    "perf:inspect": "pnpm --filter zmarkdown perf:inspect",
    "perf:inspect-brk": "pnpm --filter zmarkdown perf:inspect-brk",
    "test": "pnpm --filter zmarkdown test",
    "test:unit": "pnpm --filter zmarkdown test:unit",
    "test:e2e": "pnpm --filter zmarkdown test:e2e",
    "typecheck": "pnpm --filter zmarkdown typecheck",
    "typecheck:watch": "pnpm --filter zmarkdown typecheck:watch",
    "check": "pnpm lint && pnpm typecheck",
    "gen-third-party": "tsx scripts/generateThirdPartyLicense.ts",
    "validate-licenses": "tsx scripts/validateLicenses.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/desktop/src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/desktop/test/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "electron": "~42.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-vue": "^10.9.2",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.2.0",
    "neostandard": "^0.13.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.61.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZWLFI/zmarkdown.git"
  }
}
